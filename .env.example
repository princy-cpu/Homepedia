# Copier en .env puis adapter (ne jamais committer .env)

# MinIO (S3)
MINIO_ROOT_USER=homepedia
MINIO_ROOT_PASSWORD=change-me-minio
S3_BUCKET_RAW=raw
S3_BUCKET_WAREHOUSE=warehouse

# PostgreSQL
POSTGRES_DB=homepedia
POSTGRES_USER=homepedia
POSTGRES_PASSWORD=change-me-pg

# MongoDB
MONGO_USER=homepedia
MONGO_PASSWORD=change-me-mongo

# Spark (adapter à la RAM disponible)
SPARK_WORKER_CORES=2
SPARK_WORKER_MEMORY=2g

# Trino
TRINO_VERSION=476

# Superset (profil bi)
SUPERSET_SECRET_KEY=change-me-long-random-string
SUPERSET_ADMIN_PASSWORD=change-me-superset

# NLP
SENTIMENT_MODEL=cmarkea/distilcamembert-base-sentiment

# Scraping
SCRAPER_USER_AGENT=HomepediaStudentBot/0.1 (projet EPITECH, contact: votre-email)
SCRAPER_DELAY_SECONDS=2

# Échantillon de développement. Cible finale = France entière : laisser VIDE pour l'exécution nationale
DEV_DEPARTEMENTS=33,13,69,23
